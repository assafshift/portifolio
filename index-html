<style>
:root{--ink:#161a21;--mut:#586274;--line:#e2e6ed;--soft:#f3f5f8;--blue:#1d5cff;--volt:#3d8bff;--r:14px}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:76px}
body{font:400 17px/1.6 "Instrument Sans",system-ui,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,.logo,.pr,.gr b,.why b,.st b,figcaption b,.flow li,.sol{font-family:"Bricolage Grotesque","Instrument Sans",system-ui,sans-serif;line-height:1.1;letter-spacing:-.02em}
a{color:inherit;text-decoration:none}ul,ol{list-style:none;padding:0}
.w{width:min(1120px,100% - 40px);margin-inline:auto}
section{padding:clamp(64px,9vw,108px) 0}
.d{background:var(--ink);color:#fff}.g{background:var(--soft)}
h2{font-size:clamp(28px,4vw,44px);max-width:21ch;margin-bottom:16px}
.lead{color:var(--mut);max-width:60ch;margin-bottom:40px}.d .lead{color:#aab3c4}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 26px;border:1px solid var(--blue);border-radius:10px;background:var(--blue);color:#fff;font:700 14px "Instrument Sans",sans-serif;letter-spacing:.03em;text-align:center;cursor:pointer;transition:background .2s}
.btn:hover{background:#0e47d8}.btn.o{background:none;border-color:#fff4}.btn.o:hover{background:#ffffff14}.btn.s{min-height:40px;padding:0 16px;font-size:13px}
:focus-visible{outline:3px solid var(--volt);outline-offset:3px}
header{position:sticky;top:0;z-index:50;background:#161a21eb;backdrop-filter:blur(10px);color:#fff;border-bottom:1px solid #ffffff17}
.nav{display:flex;align-items:center;gap:26px;height:70px}
.logo{font-size:20px;font-weight:800;letter-spacing:0}.logo small{font:inherit;font-weight:600;color:#9fb0cc;margin-left:6px}
.nav ul{display:flex;align-items:center;gap:26px;margin-left:auto;font-size:15px;color:#c9d1de}.nav ul a:hover{color:#fff}
.mb{display:none;margin-left:auto;background:none;border:1px solid #fff4;color:#fff;border-radius:8px;padding:8px 14px;font-family:inherit;font-weight:600;font-size:14px}
.hero{padding:clamp(48px,8vw,92px) 0 clamp(56px,8vw,96px)}
.hero .w{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
.hero .w>*{animation:up .7s backwards}.hero .w>*:nth-child(2){animation-delay:.15s}
@keyframes up{from{opacity:0;transform:translateY(14px)}}
h1{font-size:clamp(40px,6vw,70px);margin-bottom:22px}
.hero p{color:#b4bccb;font-size:19px;max-width:46ch}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin:32px 0 24px}
.trust{display:flex;flex-wrap:wrap;gap:8px 22px;color:#b4bccb;font-size:15px}
.trust li::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--volt);margin-right:9px}
.bw{border:1px solid #ffffff1f;border-radius:12px;background:#fff;color:var(--ink);overflow:hidden;box-shadow:0 24px 60px -24px #0009}
.tb{display:flex;gap:6px;padding:10px 12px;background:#eef1f5}.tb i{width:8px;height:8px;border-radius:50%;background:#c5ccd8}
.ms{padding:18px;display:grid;gap:10px}
.ms h4{font-size:clamp(16px,2vw,21px);color:var(--c);max-width:16ch}
.ms>a{justify-self:start;background:var(--c);color:#fff;font-size:11px;font-weight:700;padding:7px 12px;border-radius:6px}
.ms p{height:6px;width:82%;border-radius:3px;background:#dfe4ec}
.mc{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:4px}.mc i{height:46px;border-radius:6px;background:color-mix(in srgb,var(--c) 14%,#fff)}
.mn{display:flex;gap:14px;align-items:center;font-size:10px;color:#7a8497;padding-bottom:10px;border-bottom:1px solid var(--line)}.mn b{margin-right:auto;color:var(--ink);font-size:12px}
.lap .ms{padding:22px;gap:12px}.lap .mc i{height:64px}
.lb{height:12px;width:108%;margin:0 -4%;background:linear-gradient(#3a4250,#232933);border-radius:0 0 14px 14px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.rows li{padding:18px 0 18px 34px;border-top:1px solid var(--line);position:relative;font-weight:600}
.rows li:last-child{border-bottom:1px solid var(--line)}
.rows li::before{content:"";position:absolute;left:0;top:29px;width:14px;height:2px;background:var(--blue)}
.sol{margin-top:48px;padding:28px 32px;border-radius:var(--r);background:var(--blue);color:#fff;font-weight:800;font-size:clamp(20px,2.6vw,28px);line-height:1.2}
.gr{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.gr li{padding:26px;background:#fff;border:1px solid var(--line);border-radius:var(--r);color:var(--mut);font-size:16px}
.gr b{display:block;font-size:19px;color:var(--ink);margin-bottom:8px}
.ic{width:28px;height:28px;margin-bottom:16px;fill:none;stroke:var(--blue);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.pl{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.pl article{display:flex;flex-direction:column;position:relative;padding:28px 24px;border:1px solid var(--line);border-radius:var(--r)}
.pl h3{font-size:21px}.pr{font-size:42px;font-weight:800;margin-top:20px;letter-spacing:-.03em}
.mo{color:var(--blue);font-weight:700;margin-bottom:14px}
.pl p{color:var(--mut);font-size:15px;flex:1;margin-bottom:24px}
.pl .top{background:var(--ink);color:#fff;border-color:var(--blue);box-shadow:0 0 0 2px var(--blue),0 28px 50px -26px #1d5cffaa;transform:translateY(-8px)}
.pl .top p{color:#b4bccb}.pl .top .mo{color:var(--volt)}
.tag{position:absolute;top:-13px;left:24px;background:var(--volt);color:#fff;font-size:12px;font-weight:700;padding:4px 12px;border-radius:99px;letter-spacing:.04em}
.ok{columns:2;column-gap:48px;margin-top:36px}
.ok li{position:relative;break-inside:avoid;padding:12px 0 12px 32px;border-bottom:1px solid var(--line)}
.ok li::before{content:"";position:absolute;left:4px;top:19px;width:12px;height:6px;border-left:2px solid var(--blue);border-bottom:2px solid var(--blue);transform:rotate(-45deg)}
.note{margin-top:28px;padding:16px 20px;border-left:3px solid var(--blue);background:#fff;color:var(--mut);font-size:15px}
.pills{display:flex;flex-wrap:wrap;gap:10px;margin:32px 0}
.pills li{padding:9px 18px;border-radius:99px;background:var(--soft);font-weight:600;font-size:15px}
.pj{display:grid;grid-template-columns:repeat(3,1fr);gap:32px 28px}
.pj figure{display:grid;gap:14px;align-content:start}
figcaption{display:block;color:#aab3c4;font-size:15px;line-height:1.45}figcaption b{display:block;color:#fff;font-size:18px;line-height:1.15;margin-bottom:5px}
.flow{display:grid;grid-template-columns:repeat(5,1fr);margin:40px 0 48px}
.flow li{position:relative;text-align:center;font-weight:700;font-size:17px;padding-top:44px}
.flow li::before{content:"";position:absolute;top:7px;left:50%;width:18px;height:18px;margin-left:-9px;border-radius:50%;background:#fff;border:2px solid #c3cad7;z-index:1;transition:background .3s,border-color .3s}
.flow li::after{content:"";position:absolute;top:15px;left:50%;width:100%;height:2px;background:#c3cad7}
.flow li:last-child::after{display:none}
.flow.in li::before{background:var(--blue);border-color:var(--blue);transition-delay:calc(var(--i)*.3s)}
.why{display:grid;grid-template-columns:repeat(3,1fr);gap:40px 32px}
.why li{border-top:2px solid var(--ink);padding-top:18px;color:var(--mut)}.why b{display:block;font-size:20px;color:var(--ink);margin-bottom:8px}
.st{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;counter-reset:s}
.st li{padding-top:20px;border-top:2px solid var(--blue);color:var(--mut)}
.st li::before{counter-increment:s;content:"0" counter(s);display:block;font-weight:700;font-size:14px;color:var(--blue);margin-bottom:6px}
.st b{display:block;font-size:21px;color:var(--ink);margin-bottom:8px}
.cta2{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.ct{margin:28px 0 12px;color:#c3cad7}.ct a{color:#fff;font-weight:600;border-bottom:1px solid #fff5}
form{display:grid;gap:14px;padding:28px;border:1px solid #ffffff26;border-radius:var(--r);background:#1e2430}
form h3{font-size:22px}label{display:grid;gap:6px;font-size:14px;color:#c3cad7}
input,select,textarea{width:100%;min-height:48px;padding:12px 14px;border-radius:8px;border:1px solid #ffffff2e;background:var(--ink);color:#fff;font:inherit}
footer{background:#10141a;color:#aab3c4;padding:52px 0;font-size:15px}
footer .w{display:grid;gap:14px}
.fab{position:fixed;z-index:60;right:20px;bottom:20px;box-shadow:0 14px 30px -10px #1d5cffbb;transform:translateY(140px);transition:transform .3s,background .2s}.fab.on{transform:none}
@media(max-width:1000px){.pl{grid-template-columns:1fr 1fr}.pl .top{transform:none}.pj,.why{grid-template-columns:1fr 1fr}.st{grid-template-columns:1fr 1fr}}
@media(max-width:860px){.hero .w,.split,.cta2{grid-template-columns:1fr}.hero .w{gap:44px}.mb{display:block}
.nav ul{display:none;position:absolute;top:70px;left:0;right:0;flex-direction:column;align-items:stretch;gap:16px;background:var(--ink);padding:18px 20px 24px;border-bottom:1px solid #ffffff17}.nav ul.open{display:flex}.ok{columns:1}}
@media(max-width:600px){body{font-size:16px}.pl,.pj,.why,.st{grid-template-columns:1fr}.flow li{font-size:13px}.hero p{font-size:17px}.cta .btn{width:100%}
.fab{left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px))}footer{padding-bottom:100px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

.fd{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;padding:20px 24px;margin-bottom:28px;border:1px solid var(--line);border-radius:var(--r);background:var(--soft)}
.fd>b{font-family:"Bricolage Grotesque",sans-serif;font-size:19px;letter-spacing:-.01em}
.fc,.qr{display:flex;flex-wrap:wrap;gap:8px}
.fc button,.qr button{padding:9px 16px;border:1px solid #c3cad7;border-radius:99px;background:#fff;color:var(--ink);font:600 14px "Instrument Sans",sans-serif;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.fc button:hover,.qr button:hover{border-color:var(--blue)}
.fc button[aria-pressed=true]{background:var(--blue);border-color:var(--blue);color:#fff}
.rc{flex-basis:100%;display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;margin:0;font-weight:600}.rc:empty{display:none}
.pl article{transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.pl article.rec{box-shadow:0 0 0 3px var(--volt)}
@media(hover:hover) and (pointer:fine){
.gr li,.pl article,.why li,.st li{transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
.gr li:hover,.why li:hover,.st li:hover{transform:translateY(-5px) scale(1.012);box-shadow:0 14px 28px -22px #161a2166;border-color:#aeb8c8}
.pl article:hover{transform:translateY(-6px) scale(1.018);box-shadow:0 18px 34px -22px #161a2166;border-color:#aeb8c8}
.pl .top:hover{transform:translateY(-11px) scale(1.018);box-shadow:0 0 0 2px var(--blue),0 28px 48px -24px #1d5cffaa}
.pj figure .demo-shot{transition:transform .18s ease,box-shadow .18s ease}
.pj figure:hover .demo-shot{transform:translateY(-6px) scale(1.012);box-shadow:0 18px 38px -24px #0009}
}
@media(prefers-reduced-motion:reduce){.gr li,.pl article,.why li,.st li,.pj figure .demo-shot{transition:none!important}}
.demo{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.demo h3{font-size:28px;margin-bottom:12px}.demo .lead{margin-bottom:0}
.chat{border:1px solid var(--line);border-radius:var(--r);background:#fff;box-shadow:0 24px 50px -28px #161a2166;overflow:hidden}
.chh{display:flex;justify-content:space-between;gap:12px;padding:14px 18px;background:var(--ink);color:#fff;font-size:14px}.chh span{color:#9fb0cc}
.msgs{display:flex;flex-direction:column;gap:8px;height:300px;overflow:auto;padding:16px;background:var(--soft)}
.msgs p{max-width:84%;padding:10px 14px;font-size:15px;line-height:1.4;animation:up .25s}
.msgs .b{align-self:flex-start;background:#fff;border:1px solid var(--line);border-radius:14px 14px 14px 4px}
.msgs .u{align-self:flex-end;background:var(--blue);color:#fff;border-radius:14px 14px 4px 14px}
.msgs .t{color:var(--mut);letter-spacing:2px;animation:blink 1s infinite}
.msgs .btn{align-self:flex-start;margin-top:4px}
@keyframes blink{50%{opacity:.35}}
.qr{padding:14px 16px;border-top:1px solid var(--line)}

/* Demonstrações: miniaturas visuais de sites fictícios */
.pj figure .demo-shot{
  position:relative;width:100%;height:250px;overflow:hidden;
  border:1px solid #ffffff22;border-radius:12px;background:#fff;
  box-shadow:0 24px 50px -30px #000b;
  transition:transform .2s ease,box-shadow .2s ease;
}
.pj figure .demo-shot img{
  display:block;width:100%;height:100%;min-width:100%;min-height:100%;
  object-fit:cover;object-position:center;
}
.pj figure .demo-shot.clinic-demo{background:#f5f1ee}
.pj figure .demo-shot.clinic-demo .clinic-card-img{object-fit:cover;object-position:center;width:100%;height:100%;display:block}
.clinic-overlay{position:absolute;left:16px;bottom:16px;display:grid;gap:4px;max-width:58%;padding:12px 14px;border-radius:10px;background:rgba(37,30,27,.72);backdrop-filter:blur(4px);color:#fff}
.clinic-overlay strong{font:700 18px/1.1 "Bricolage Grotesque",system-ui,sans-serif}
.clinic-overlay span{font-size:13px;color:#f4e9df}
.clinic-overlay em{font-style:normal;justify-self:start;margin-top:3px;padding:6px 10px;border-radius:7px;background:#fff;color:#332b27;font-size:11px;font-weight:700}
dialog .demo-modal .clinic-demo{height:270px}
@media(max-width:600px){.clinic-overlay{left:12px;bottom:12px;max-width:64%;padding:10px 12px}.clinic-overlay strong{font-size:16px}.clinic-overlay span{font-size:12px}.clinic-overlay em{font-size:10px}}
.pj figure:hover .demo-shot{
  transform:translateY(-6px) scale(1.012);
  box-shadow:0 22px 42px -25px #000b;
}
.demo-shot .browser-bar{
  position:absolute;z-index:2;top:0;left:0;right:0;height:30px;
  display:flex;align-items:center;gap:5px;padding:0 11px;
  background:#eef1f5;border-bottom:1px solid #d9dee7;
}
.demo-shot .browser-bar i{width:7px;height:7px;border-radius:50%;background:#b9c1ce}
.demo-shot .browser-url{margin-left:8px;height:14px;flex:1;border-radius:8px;background:#fff;border:1px solid #dde2e9}
@media(max-width:600px){.pj figure .demo-shot{height:220px}}

.pj figure{cursor:pointer}.pj .demo-shot{transition:transform .25s}@media(hover:hover){.pj figure:hover .demo-shot{transform:translateY(-4px)}}
dialog{border:0;border-radius:var(--r);padding:0;width:min(520px,calc(100% - 32px));background:#fff;color:var(--ink);box-shadow:0 30px 80px -20px #000a}
dialog::backdrop{background:#0b0e13b3}dialog[open]{animation:up .25s}
.di{padding:28px}dialog .demo-modal{margin:8px 0 22px;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 12px 30px -18px #0006;background:#fff} dialog .demo-modal .demo-shot{height:270px}
dialog .ms{padding:26px}dialog .mc i{height:72px}
dialog h3{font-size:24px;margin-bottom:6px}dialog .ok{columns:1;margin:6px 0 24px}
.x{position:absolute;top:8px;right:14px;background:none;border:0;font-size:30px;line-height:1;color:var(--mut);cursor:pointer}
@media(max-width:860px){.demo{grid-template-columns:1fr;gap:28px}}

html{background:#10141a;scroll-padding-top:calc(76px + env(safe-area-inset-top,0px))}
body{background:#fff;-webkit-tap-highlight-color:transparent}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
