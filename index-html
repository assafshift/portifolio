/* Programa de parceria — seção independente e leve */
.partner-head{max-width:760px;margin-bottom:38px}
.partner-kicker{display:inline-flex;margin-bottom:14px;color:var(--blue);font:700 12px/1.2 "Instrument Sans",sans-serif;letter-spacing:.09em}
.partner-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;align-items:stretch}
.partner-card{padding:28px;border:1px solid var(--line);border-radius:var(--r);background:#fff}
.partner-card.dark{background:var(--ink);color:#fff;border-color:#ffffff18}
.partner-card h3{font-size:23px;margin-bottom:10px}
.partner-card p{color:var(--mut);font-size:15px}.partner-card.dark p{color:#b4bccb}
.partner-list{display:grid;gap:0;margin-top:18px}
.partner-list li{padding:13px 0 13px 28px;border-top:1px solid var(--line);position:relative;color:var(--mut);font-size:15px}
.partner-card.dark .partner-list li{border-color:#ffffff18;color:#c3cad7}
.partner-list li::before{content:"✓";position:absolute;left:0;top:13px;color:var(--blue);font-weight:800}
.partner-table{width:100%;border-collapse:collapse;margin-top:20px;font-size:15px}
.partner-table th,.partner-table td{text-align:left;padding:13px 10px;border-bottom:1px solid var(--line)}
.partner-card.dark .partner-table th,.partner-card.dark .partner-table td{border-color:#ffffff18}
.partner-table th{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--mut)}
.partner-card.dark .partner-table th{color:#9fb0cc}.partner-table td:last-child{font-weight:800;color:var(--blue)}
.partner-flow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:24px}
.partner-step{padding:20px 16px;border:1px solid var(--line);border-radius:var(--r);background:var(--soft)}
.partner-step b{display:block;color:var(--blue);font-size:13px;margin-bottom:7px}.partner-step span{font-size:14px;font-weight:600}
.partner-note{margin-top:22px;padding:15px 18px;border-left:3px solid var(--blue);background:var(--soft);color:var(--mut);font-size:14px}
