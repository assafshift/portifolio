  const add = (cls, txt) => {
    const p = document.createElement("p");
    p.className = cls;
    p.textContent = txt;
    msgs.append(p);
    msgs.scrollTop = msgs.scrollHeight;
    return p;
  };
  document.querySelector(".qr").addEventListener("click", e => {
    const b = e.target.closest("button");
    if (!b || busy) return;
    busy = true;
    const [pergunta, resposta] = R[b.dataset.q];
    add("u", pergunta);
    const t = add("b t", "•••");
    setTimeout(() => {
      t.className = "b";
      t.textContent = resposta;
      if (/agendar|equipe/.test(b.dataset.q) && !msgs.querySelector(".btn")) {
        const l = document.createElement("a");
        l.className = "btn s";
        l.textContent = "Quero um atendimento assim";
        l.target = "_blank";
        l.rel = "noopener";
        l.href = wa("Olá, Henrique! Vi a demonstração de atendimento automático e quero algo assim para minha empresa.");
        msgs.append(l);
      }
      msgs.scrollTop = msgs.scrollHeight;
      busy = false;
    }, 700);
  });

  // Demonstrações de projetos: toque para ver os detalhes
  const F = {
    "Clínica": ["Agendamento online", "Presença no Google (SEO local)", "Contato direto pelo WhatsApp"],
    "Restaurante": ["Cardápio digital organizado", "Horários de atendimento", "Pedidos pelo WhatsApp"],
    "Loja": ["Catálogo de produtos e ofertas", "Opção de loja virtual", "Atendimento pelo WhatsApp"],
    "Salão": ["Serviços e preços", "Agendamento de horários", "Contato direto pelo WhatsApp"],
    "Imobiliária": ["Vitrine de imóveis", "Formulário para captar contatos", "Presença no Google (SEO local)"],
    "Serviço profissional": ["Apresentação dos serviços", "Pedido de orçamento", "Triagem com IA, se desejar"]
  };
  const dm = document.getElementById("dm");
  const abrir = f => {
    const nome = f.querySelector("figcaption b")?.textContent.trim();
    if (!nome || !F[nome]) return;

    const modalShot = dm.querySelector(".demo-modal");
    const cardShot = f.querySelector(".demo-shot");
    if (!modalShot || !cardShot) return;

    modalShot.innerHTML = "";
    modalShot.appendChild(cardShot.cloneNode(true));

    dm.querySelector("h3").textContent = nome;
    dm.querySelector(".ok").innerHTML = F[nome].map(x => `<li>${x}</li>`).join("");
    dm.querySelector(".btn").href = wa(`Olá, Henrique! Vi o exemplo de site para ${nome.toLowerCase()} e gostaria de um projeto parecido para minha empresa.`);

    if (typeof dm.showModal === "function") dm.showModal();
    else dm.setAttribute("open", "");
  };
  document.querySelectorAll(".pj figure").forEach(f => {
    f.tabIndex = 0;
    f.setAttribute("role", "button");
    f.addEventListener("click", () => abrir(f));
    f.addEventListener("keydown", e => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); abrir(f); }
    });
  });
  dm.addEventListener("click", e => { if (e.target === dm || e.target.closest(".x")) { if (typeof dm.close === "function") dm.close(); else dm.removeAttribute("open"); } });

  // Barra de progresso e destaque do menu conforme a rolagem
  const prog = document.querySelector(".prog");
  const links = [...document.querySelectorAll("#menu a[href^='#']")];
  const alvos = links.map(a => document.querySelector(a.getAttribute("href")));
  const aoRolar = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    prog.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    let atual = -1;
    alvos.forEach((s, i) => { if (s && s.getBoundingClientRect().top <= 120) atual = i; });
    links.forEach((a, i) => a.classList.toggle("on", i === atual));
  };
  addEventListener("scroll", aoRolar, { passive: true });
  aoRolar();

  // Notebook do topo acompanha o mouse (somente em telas com mouse)
  const lap = document.querySelector(".lap");
  if (matchMedia("(hover:hover) and (pointer:fine)").matches && !matchMedia("(prefers-reduced-motion:reduce)").matches) {
    const topo = document.getElementById("inicio");
    topo.addEventListener("pointermove", e => {
      const r = topo.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      lap.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 6}deg)`;
    });
    topo.addEventListener("pointerleave", () => { lap.style.transform = ""; });
  }
})();
</script>
</body>
</html>
